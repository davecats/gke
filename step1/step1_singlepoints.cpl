!
! This program computes and stores the single-point budgets of the Reynolds
! stress tensor. Some terms are used to compute the Generalized Kolmogorov Equation (GKE)
!
! The statistics are accumulated point by point over the fluid points of
! each wall-parallel plane (points inside a particle are skipped) and every
! average is renormalized by the number of accumulated points. The velocity
! gradient is computed with the finite differences of gkedata.cpl. The planes
! are processed in parallel by OpenMP threads: compile with -fopenmp.
!
! ------------------------------------------------------------------------------
! If you use this code and find it helpful please cite
!
! D. Gatti et al., "An efficient numerical method for the Generalized Kolmogorov
! Equation", Journal of Turbulence, (submitted, 2018)
! ------------------------------------------------------------------------------
!
! Copyright (C) 2018  Dr. Davide Gatti
!
! This program is free software: you can redistribute it and/or modify
! it under the terms of the GNU General Public License as published by
! the Free Software Foundation, either version 3 of the License, or
! any later version.
!
! This program is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
! GNU General Public License for more details.
!
! You should have received a copy of the GNU General Public License
! along with this program.  If not, see <https://www.gnu.org/licenses/>.
!
! Contacts:
!
! Dr. Davide Gatti
! davide.gatti [at] kit.edu
! msc.davide.gatti [at] gmail.com
!
! Karlsruhe Institute of Technology
! Institute of Fluid Dynamics
! Kaiserstraße 10
! 76131 Karlsruhe
!

USE ../gkedata

ARRAY(-1..ny+1) OF MEANTERMS meantot=0
ARRAY(-1..ny+1) OF BALANCE uiujtot=0
ARRAY(-1..ny+1) OF MKETERMS mketot=0

! Compute the average field
! ------------------------------------
LOOP files FOR n=nfmin TO nfmax BY dn
  readsnapshot(n)
#pragma omp parallel for
  LOOP FOR iy=-1 TO ny+1
    INTEGER npoint=0
    REAL sU=0, sV=0, sW=0, sP=0
    DO
      IF fluid(iy,ix,iz)>0.5 THEN sU=~+u(iy,ix,iz); sV=~+v(iy,ix,iz); sW=~+w(iy,ix,iz); sP=~+p(iy,ix,iz); INC npoint
    FOR ix=0 TO nx-1 AND iz=0 TO nz-1
    IF npoint>0 THEN WITH meantot(iy): U=~+sU/npoint; V=~+sV/npoint; W=~+sW/npoint; P=~+sP/npoint
  REPEAT LOOP
REPEAT files
WITH meantot: U=~/nftot; V=~/nftot; W=~/nftot; P=~/nftot
WITH meantot:  deriv(U, Uy);  deriv(V, Vy);  deriv(W, Wy)
WITH meantot: deriv2(U, Uyy); deriv2(V, Vyy); deriv2(W, Wyy)

! Compute the TKE budget
! ------------------------------------
LOOP fields FOR n=nfmin TO nfmax BY dn
  readsnapshot(n)
#pragma omp parallel for
  LOOP FOR iy=-1 TO ny+1
    INTEGER npoint=0
    REAL spu=0, spv=0, spw=0
    ARRAY(1..6) OF REAL svar=0, spst=0, spsd=0, sttr=0
    LOOP FOR ix=0 TO nx-1 AND iz=0 TO nz-1
      IF fluid(iy,ix,iz)>0.5 THEN WITH meantot(iy)
        ! Fluctuations and their gradient (the wall-normal derivative of the
        ! mean profiles is taken with the same operator as that of the fields)
        REAL uf=u(iy,ix,iz)-U, vf=v(iy,ix,iz)-V, wf=w(iy,ix,iz)-W, pf=p(iy,ix,iz)-P
        REAL ux=dudx(iy,ix,iz),  uy=ddy(u,iy,ix,iz)-ddy(meantot.U,iy), uz=ddz(u,iy,ix,iz)
        REAL vx=ddx(v,iy,ix,iz), vy=dvdy(iy,ix,iz)-ddy(meantot.V,iy),  vz=ddz(v,iy,ix,iz)
        REAL wx=ddx(w,iy,ix,iz), wy=ddy(w,iy,ix,iz)-ddy(meantot.W,iy), wz=dwdz(iy,ix,iz)
        svar(1)=~+uf*uf; svar(2)=~+vf*vf; svar(3)=~+wf*wf
        svar(4)=~+uf*vf; svar(5)=~+uf*wf; svar(6)=~+vf*wf
        spu=~+uf*pf; spv=~+vf*pf; spw=~+wf*pf
        spst(1)=~+2*ux*pf; spst(2)=~+2*vy*pf; spst(3)=~+2*wz*pf
        spst(4)=~+[uy+vx]*pf; spst(5)=~+[uz+wx]*pf; spst(6)=~+[vz+wy]*pf
        spsd(1)=~+ux*ux+uy*uy+uz*uz
        spsd(2)=~+vx*vx+vy*vy+vz*vz
        spsd(3)=~+wx*wx+wy*wy+wz*wz
        spsd(4)=~+ux*vx+uy*vy+uz*vz
        spsd(5)=~+ux*wx+uy*wy+uz*wz
        spsd(6)=~+vx*wx+vy*wy+vz*wz
        sttr(1)=~+vf*uf*uf; sttr(2)=~+vf*vf*vf; sttr(3)=~+vf*wf*wf
        sttr(4)=~+uf*vf*vf; sttr(5)=~+uf*vf*wf; sttr(6)=~+vf*vf*wf
        INC npoint
      END IF
    REPEAT
    IF npoint>0 THEN
      REAL cn=1.0/npoint
      DO WITH uiujtot(iy):
        var(i)=~+svar(i)*cn; pstrain(i)=~+spst(i)*cn; psdiss(i)=~+2*ni*spsd(i)*cn; PHIttrsp(i)=~-sttr(i)*cn
      FOR i=1 TO 6
      WITH uiujtot(iy): PHIptrsp(2)=~-2*spv*cn; PHIptrsp(4)=~-spu*cn; PHIptrsp(6)=~-spw*cn
    END IF
  REPEAT LOOP
REPEAT fields
! var,PHIttrsp,psdiss,pstrain
DO WITH uiujtot(iy): var(i)=~/nftot; PHIptrsp(i)=~/nftot; PHIttrsp(i)=~/nftot; psdiss(i)=~/nftot; pstrain(i)=~/nftot FOR i=1 TO 6 AND ALL iy
! PHIvdiff, vdiff
DO WITH uiujtot:  deriv(var(*,i),PHIvdiff(*,i)); PHIvdiff(*,i)=~*ni; FOR i=1 TO 6;
DO WITH uiujtot: deriv2(var(*,i),vdiff(*,i));    vdiff(*,i)=~*ni;    FOR i=1 TO 6;
! ttrsp
DO WITH uiujtot: deriv(PHIttrsp(*,i),ttrsp(*,i)); FOR i=1 TO 6;
! ptrsp
DO WITH uiujtot: deriv(PHIptrsp(*,i),ptrsp(*,i)); FOR i=1 TO 6;
! prod
DO WITH meantot(iy), uiujtot(iy)
  prod(1)=-2*var(4)*Uy; prod(2)=-2*var(2)*Vy; prod(3)=-2*var(6)*Wy
  prod(4)=-var(2)*Uy-var(4)*Vy; prod(5)=-var(4)*Wy-var(6)*Uy; prod(6)=-var(2)*Wy-var(6)*Vy
FOR ALL iy
! conv (mean convection)
LOOP FOR i=1 TO 6
  ARRAY(-1..ny+1) OF REAL PHIconv=0
  DO PHIconv(iy)=-meantot(iy).V*uiujtot(iy).var(i) FOR ALL iy
  WITH uiujtot: deriv(PHIconv,conv(*,i))
REPEAT
! MKE budget (assumes V=0)
DO WITH meantot(iy), uiujtot(iy), mketot(iy): produv=-0.5*prod(1); prodvw=-0.5*prod(3) FOR ALL iy
! dissU(MKE) and dissW(MKE)
DO WITH meantot(iy), mketot(iy): dissU=ni*Uy^2; dissW=ni*Wy^2 FOR ALL iy
! ttrsp(MKE)
DO WITH meantot(iy), uiujtot(iy), mketot(iy): mketot(iy).PHIttrsp=-var(4)*U-var(6)*W FOR ALL iy
WITH mketot: deriv(PHIttrsp,ttrsp);
! vdiff(MKE)
DO WITH meantot(iy), mketot(iy): PHIvdiff=ni*(U*Uy+W*Wy) FOR ALL iy
WITH mketot: deriv(PHIvdiff,vdiff);
! pump(MKE)
WITH mketot,meantot: pump=ni*U*0.5*(Uy(-1)-Uy(ny+1))

! Write to binary file
! ------------------------------------
uiujimage = OPEN("uiuj.bin")
WITH uiujimage:
    meandata(-1..ny+1)=meantot(-1..ny+1)
    mkedata(-1..ny+1)=mketot(-1..ny+1)
    uiujdata(-1..ny+1)=uiujtot(-1..ny+1)
CLOSE(uiujimage)

! Be polite and say goodbye
! ------------------------------------
IF has_terminal THEN WRITE "Finished!"
