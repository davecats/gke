! Two-dimensional real <-> complex FFTs of wall-parallel planes (FFTW3)
!
!   RFFT2(r,c): c(kx,kz) = SUM r(ix,iz)*exp(-2*pi*I*(kx*ix/n0+kz*iz/n1))
!   HFFT2(c,r): r(ix,iz) = SUM c(kx,kz)*exp(+2*pi*I*(kx*ix/n0+kz*iz/n1))
!
! with r=ARRAY(0..n0-1,0..n1-1) OF REAL and c=ARRAY(0..n0-1,0..n1 DIV 2) OF
! COMPLEX, both contiguous; no normalization is applied, so that HFFT2
! inverts RFFT2 up to a factor n0*n1. HFFT2 overwrites its input. The
! transforms may be issued concurrently by OpenMP threads.

USE complex
#include "fftw3.h"
#include <pthread.h>
#link "-lfftw3 -lm"

SUBROUTINE RFFT2(REAL r(*,*); COMPLEX c^(*,*)) FOLLOWS
SUBROUTINE HFFT2(COMPLEX c^(*,*); REAL r^(*,*)) FOLLOWS

C SECTION
/* One plan per direction and size, created on first use under a mutex
   (the FFTW planner is not thread-safe) and executed with the new-array
   interface, which is thread-safe; FFTW_UNALIGNED allows any array. */
pthread_mutex_t cplfft2_lock=PTHREAD_MUTEX_INITIALIZER;
void cplfft2(int forward, int n0, int n1, double *r, double *c){
  static fftw_plan plan[2]={NULL,NULL};
  static int size[2][2];
  pthread_mutex_lock(&cplfft2_lock);
  if(plan[forward]==NULL || size[forward][0]!=n0 || size[forward][1]!=n1){
    if(plan[forward]!=NULL) fftw_destroy_plan(plan[forward]);
    plan[forward]=forward ?
      fftw_plan_dft_r2c_2d(n0,n1,r,(fftw_complex *)c,FFTW_ESTIMATE|FFTW_UNALIGNED) :
      fftw_plan_dft_c2r_2d(n0,n1,(fftw_complex *)c,r,FFTW_ESTIMATE|FFTW_UNALIGNED);
    size[forward][0]=n0; size[forward][1]=n1;
  }
  pthread_mutex_unlock(&cplfft2_lock);
  if(forward) fftw_execute_dft_r2c(plan[1],r,(fftw_complex *)c);
  else fftw_execute_dft_c2r(plan[0],(fftw_complex *)c,r);
}
/* Checks that r (n0 x n1) and c (n0 x n1/2+1) are contiguous */
void cplfft2_check(int n0, int n1, ssize_t ri, ssize_t rii, int cn0, int cn1, ssize_t ci, ssize_t cii){
  if(rii!=sizeof(double) || ri!=n1*sizeof(double) || cn0!=n0 || cn1!=n1/2+1 ||
     cii!=2*sizeof(double) || ci!=cn1*2*sizeof(double)){
    fprintf(stderr,"RFFT2/HFFT2: arrays of wrong size or not contiguous\n"); exit(1);
  }
}
END C SECTION

SUBROUTINE RFFT2(REAL r(*,*); COMPLEX c^(*,*))
C SECTION
  int n0=r_h-r_l+1, n1=r__h-r__l+1;
  cplfft2_check(n0,n1,r_i,r__i,c_h-c_l+1,c__h-c__l+1,c_i,c__i);
  cplfft2(1,n0,n1,(double *)r___,(double *)c___);
END C SECTION
END RFFT2

SUBROUTINE HFFT2(COMPLEX c^(*,*); REAL r^(*,*))
C SECTION
  int n0=r_h-r_l+1, n1=r__h-r__l+1;
  cplfft2_check(n0,n1,r_i,r__i,c_h-c_l+1,c__h-c__l+1,c_i,c__i);
  cplfft2(0,n0,n1,(double *)r___,(double *)c___);
END C SECTION
END HFFT2
