! Reader for parameter files in Fortran namelist format, e.g.
!
!   &group
!   name = 480,160,240   ! comment
!   /
!
! nmlvalue(file,name,i) returns the i-th (from 1) comma-separated value
! assigned to name, irrespective of the group it belongs to. A missing
! file, name or value halts the program with an error message.

#include <string.h>
#include <ctype.h>

REAL FUNCTION nmlvalue(STRING file, name; INTEGER i) FOLLOWS

C SECTION
double cplnml_value(const char *file, const char *name, int i){
  char line[4096]; char *s, *c; size_t n=strlen(name); int k; FILE *f=fopen(file,"r");
  if(f==NULL){ fprintf(stderr,"namelist: cannot open %s\n",file); exit(1); }
  while(fgets(line,sizeof(line),f)!=NULL){
    if((c=strchr(line,'!'))!=NULL) *c=0;
    for(s=line; isspace(*s); s++);
    if(strncmp(s,name,n)!=0) continue;
    for(s+=n; isspace(*s); s++);
    if(*s!='=') continue;
    s++;
    for(k=1; k<i && s!=NULL; k++){ s=strchr(s,','); if(s!=NULL) s++; }
    if(s==NULL) break;
    fclose(f); return strtod(s,NULL);
  }
  fprintf(stderr,"namelist: value %d of %s not found in %s\n",i,name,file); exit(1);
}
END C SECTION

REAL FUNCTION nmlvalue(STRING file, name; INTEGER i)=cplnml_value(file,name,i)
