!
! Computes the source term, space and scale flux
! in the generalized Kolmogorov equation specialized
! for channel flow, as in Marati, Casciola, Piva, JFM 2004,
! equation 3.4 and following definitions.
!
! This is the physical-space implementation: the two-point statistics are
! accumulated directly over pairs of points (x, x+r) of the physical grid,
! instead of using the convolution theorem as in step2_gke_fourier.cpl.
! For single-phase flows the results of the two implementations are identical
! up to round-off, but this one is slower. Its purpose is masked statistics,
! e.g. for particle-laden flows: for each snapshot "Dati.cart.<n>.fld" an
! optional indicator field "mask.<n>.fld" is read if present
! [STORED ARRAY(-1..ny+1,0..2*nxd-1,0..nzd-1) OF REAL; 1.0=fluid, 0.0=solid].
! Pairs with at least one point inside a particle are skipped and averages are
! renormalized by the number of accumulated pairs; without a mask file all
! points are fluid, which reproduces the unmasked results exactly.
!
! This program allows distributed memory parallelization by distributing
! the arrays containing the terms of the Generalized Kolmogorov Equations (GKE)
! along the wall-normal direction.
!
! ------------------------------------------------------------------------------
!
! Comment "#define wholefield" to reduce memory requirement by reading only one
! (iy1,iy2) pair of velocity planes at a time. This increases the amount of I/O
! and supposedly slows down calculations
!
#define wholefield
#define physicalspace
!
! ------------------------------------------------------------------------------
! If you use this code and find it helpful please cite
!
! D. Gatti et al., "An efficient numerical method for the Generalized Kolmogorov
! Equation", Journal of Turbulence, (submitted, 2018)
! ------------------------------------------------------------------------------
!
! Copyright (C) 2018  Dr. Davide Gatti
!
! This program is free software: you can redistribute it and/or modify
! it under the terms of the GNU General Public License as published by
! the Free Software Foundation, either version 3 of the License, or
! any later version.
!
! This program is distributed in the hope that it will be useful,
! but WITHOUT ANY WARRANTY; without even the implied warranty of
! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
! GNU General Public License for more details.
!
! You should have received a copy of the GNU General Public License
! along with this program.  If not, see <https://www.gnu.org/licenses/>.
!
! Contacts:
!
! Dr. Davide Gatti
! davide.gatti [at] kit.edu
! msc.davide.gatti [at] gmail.com
!
! Karlsruhe Institute of Technology
! Institute of Fluid Dynamics
! Kaiserstraße 10
! 76131 Karlsruhe
!

USE ../gkedata
USE ../wallclock
REAL t1,t2,t3,t4

! Shared-memory parallelism of this program relies on OpenMP threads: compile
! with "-fopenmp", select the thread count with OMP_NUM_THREADS, and prefer
! OMP_WAIT_POLICY=passive. The (jx,jz) separations are independent tasks, so
! the results are identical to the serial ones down to the last bit for any
! thread count.

SHARED ARRAY(-1..ny+1,0..mx-1,0..mz-1) OF GKETERMS gke=0
! Raw pair sums of each separation jj=jx*mz+jz, filled by the accumulation
! kernel: 1..9 = sSE,sFX,sFY,sFZ,sFC,sUV,sUVS,sGX,sGZ; 10 = pair count
ARRAY(0..mx*mz-1,1..10) OF REAL SR=0

! Keep the plane fields, the mask, the separations and the pair-sum buffer
! resident on the GPU in the OpenACC build (no effect otherwise)
#pragma acc enter data copyin(PH,gmask,imx,imz,SR)
! Compute Kolmogorov Equation
! -------------------------------
LOOP files FOR if=nfmin TO nfmax BY dn
 ! With the default libgomp wait policy, busy-waiting threads can slow down
 ! the many small OpenMP parallel regions dramatically when all hardware
 ! threads are used; suggest the passive policy if none was chosen.
 IF if=nfmin THEN
 <*
 #ifdef _OPENMP
 if(getenv("OMP_WAIT_POLICY")==NULL)fprintf(stderr,"HINT: consider setting OMP_WAIT_POLICY=passive, which can speed up the OpenMP parallel regions considerably.\n");
 #endif
 *>
 END IF
 WRITE "iproc=",iproc, "   ","file ", if, " of ", nfmax;
 ! Open V and P fields, and the particle mask if present
 STRING field_name = WRITE("Dati.cart."if".fld"); diskimage = OPEN(field_name);
 STRING pressure_name = WRITE('pField'if'.fld');  pressuredata=OPEN(pressure_name);
 STRING mask_name = WRITE("mask."if".fld"); maskimage=OPENRO(mask_name)
 IF maskimage=NULL THEN DO gmask(i,ix,iz)=1 FOR ALL i,ix,iz
#ifdef wholefield
 WRITE "iproc=",iproc, "   ","Reading data..."; t1=wallclock();
  Vtot=diskimage.Vimage; CLOSE diskimage
  ptot=pressuredata; CLOSE pressuredata; t2=wallclock();
 WRITE "iproc=",iproc, "   ","Reading took ", t2-t1, " seconds"
#endif
   LOOP outer FOR IY1=nyl TO nyh;
     WRITE "iproc=",iproc, "   ", "   ", "IY1= ",IY1, "of", nyh; gke(IY1+(0..ny-2*IY1),*,*)=0; t1=wallclock();
     ! Reload data for this IY1, need for averaging "on disk"
     WRITE "iproc=",iproc, "   ", "   ", "   ", "Reading gke data..."; t3=wallclock();
     IF if>nfmin THEN gke(IY1+(0..ny-2*IY1),*,*)=gkedata(startpos(IY1)+(0..ny-2*IY1),*,*) ELSE gke(IY1+(0..ny-2*IY1),*,*)=0; END IF; t4=wallclock();
     WRITE "iproc=",iproc, "   ", "   ", "   ", "Reading took ", t4-t3, " seconds"
     LOOP FOR sig IN (1,-1)
        ! Symmetry-aware helper variable
        iy1=IF sig=1 THEN IY1 ELSE ny-IY1
        ! Open V and p field
#ifdef wholefield
        V(*,*,1)=Vtot(iy1,*,*); mean(1)=uiujimage.meandata(iy1); p(*,*,1)=ptot(iy1,*,*); uiuj(1)=uiujimage.uiujdata(iy1)
#else
        bufV = diskimage.Vimage(iy1,*,*); V(*,*,1)=bufV; mean(1)=uiujimage.meandata(iy1); uiuj(1)=uiujimage.uiujdata(iy1)
        pressuredata=OPEN(pressure_name); bufp = pressuredata(iy1,*,*); p(*,*,1)=bufp;
#endif
        ! Remove mean
        WITH mean(1),V(0,0,1): u.REAL=~-U; w.REAL=~-W; p(0,0,1)=~-P;
        IF maskimage#NULL THEN gmask(1,*,*)=maskimage(iy1,*,*)
        preparephys(1)
        LOOP inner FOR IY2=IY1 TO ny-IY1
          iy2 = IF sig=1  THEN IY2 ELSE ny-IY2
          ! Open V and p field, remove mean
#ifdef wholefield
          V(*,*,2)=Vtot(iy2,*,*); p(*,*,2)=ptot(iy2,*,*); mean(2)=uiujimage.meandata(iy2); uiuj(2)=uiujimage.uiujdata(iy2);
#else
          bufV = diskimage.Vimage(iy2,*,*); V(*,*,2)=bufV; mean(2)=uiujimage.meandata(iy2);
          bufp = pressuredata(iy2,*,*);     p(*,*,2)=bufp; uiuj(2)=uiujimage.uiujdata(iy2);
#endif
          WITH mean(2),V(0,0,2): u.REAL=~-U; w.REAL=~-W; p(0,0,2)=~-P;
          IF maskimage#NULL THEN gmask(2,*,*)=maskimage(iy2,*,*)
          preparephys(2)
          ! Direct accumulation of the two-point statistics over pairs of
          ! points (x, x+r) of the physical grid; pairs with at least one
          ! point inside a particle are skipped. Each jj identifies one
          ! independent separation (jx,jz), whose raw pair sums are written
          ! to SR: on the GPU (OpenACC build), on a thread pool (OpenMP
          ! build) or serially, with results identical to the last bit
          ! between the serial and the OpenMP version.
#pragma acc update device(PH,gmask)
#pragma acc parallel loop gang present(PH,gmask,imx,imz,SR)
#pragma omp parallel for schedule(dynamic)
          LOOP FOR jj=0 TO mx*mz-1
            INTEGER jx=jj DIV mz, jz=jj MOD mz
            INTEGER rx=imx(jx), rz=imz(jz), npair=0
            REAL sSE=0, sFX=0, sFY=0, sFZ=0, sFC=0, sUV=0, sUVS=0, sGX=0, sGZ=0
#pragma acc loop vector collapse(2) reduction(+:sSE,sFX,sFY,sFZ,sFC,sUV,sUVS,sGX,sGZ,npair)
            LOOP FOR ix=0 TO 2*nxd-1
              LOOP FOR iz=0 TO nzd-1
                INTEGER ix2=(ix+rx) MOD nxc, iz2=(iz+rz) MOD nzd
                IF gmask(1,ix,iz)>0.5 AND gmask(2,ix2,iz2)>0.5 THEN
                  REAL du=PH(2,fU,ix2,iz2)-PH(1,fU,ix,iz), dv=PH(2,fV,ix2,iz2)-PH(1,fV,ix,iz), dw=PH(2,fW,ix2,iz2)-PH(1,fW,ix,iz)
                  REAL dpp=PH(2,fP,ix2,iz2)-PH(1,fP,ix,iz), vs=PH(1,fV,ix,iz)+PH(2,fV,ix2,iz2)
                  REAL e2=du*du+dv*dv+dw*dw
                  sSE=~+e2; sFX=~+e2*du; sFY=~+e2*dv; sFZ=~+e2*dw
                  sFC=~+0.5*vs*e2+2*dpp*dv
                  sUV=~+du*dv; sUVS=~+du*vs
                  sGX=~+du*(PH(1,fUX,ix,iz)+PH(2,fUX,ix2,iz2))+dv*(PH(1,fVX,ix,iz)+PH(2,fVX,ix2,iz2))+dw*(PH(1,fWX,ix,iz)+PH(2,fWX,ix2,iz2))
                  sGZ=~+du*(PH(1,fUZ,ix,iz)+PH(2,fUZ,ix2,iz2))+dv*(PH(1,fVZ,ix,iz)+PH(2,fVZ,ix2,iz2))+dw*(PH(1,fWZ,ix,iz)+PH(2,fWZ,ix2,iz2))
                  INC npair
                END IF
              REPEAT
            REPEAT
            SR(jj,1)=sSE; SR(jj,2)=sFX; SR(jj,3)=sFY; SR(jj,4)=sFZ; SR(jj,5)=sFC
            SR(jj,6)=sUV; SR(jj,7)=sUVS; SR(jj,8)=sGX; SR(jj,9)=sGZ; SR(jj,10)=npair
          REPEAT
          ! Renormalize the pair sums by the number of accumulated pairs and
          ! update the GKE terms (on the host: this part is cheap)
#pragma acc update host(SR)
          LOOP FOR jj=0 TO mx*mz-1
            INTEGER jx=jj DIV mz, jz=jj MOD mz
            IF SR(jj,10)>0.5 THEN
              REAL cn=1.0/SR(jj,10)
              REAL iscaleENER=SR(jj,1)*cn
              gke(IY2,jx,jz).scaleENER=~+iscaleENER
              gke(IY2,jx,jz).phiR(1)=~+SR(jj,2)*cn+iscaleENER*[mean(2).U-mean(1).U]-2*ni*SR(jj,8)*cn
              gke(IY2,jx,jz).phiR(2)=~+sig*SR(jj,3)*cn
              gke(IY2,jx,jz).phiR(3)=~+SR(jj,4)*cn+iscaleENER*[mean(2).W-mean(1).W]-2*ni*SR(jj,9)*cn
              gke(IY2,jx,jz).phiC=~+sig*[SR(jj,5)*cn]
              gke(IY2,jx,jz).scalePROD=~-[SR(jj,6)*cn]*[mean(1).Uy+mean(2).Uy]-[SR(jj,7)*cn]*[mean(2).Uy-mean(1).Uy]-[SUM uiuj(1).psdiss(i)+uiuj(2).psdiss(i) FOR i=1 TO 3]
            END IF
          REPEAT
        REPEAT inner
     REPEAT
     WRITE "iproc=",iproc, "   ", "   ", "IY1= ",IY1, "of", nyh, " took ", (wallclock()-t1)/60 , " minutes"
     ! Average on disk
     WRITE "iproc=",iproc,"   ", "   ", "   ", "Writing gke data..."; t3=wallclock();
     IF if=nfmax THEN WITH gke(IY1+(0..ny-2*IY1),*,*):INLINE LOOP FOR i IN (phiR,phiC,scaleENER,scalePROD) i=~*0.5/nftot;REPEAT
     gkedata(startpos(IY1)+(0..ny-2*IY1),*,*)=gke(IY1+(0..ny-2*IY1),*,*); t4=wallclock();
     WRITE "iproc=",iproc,"   ", "   ", "   ", "Writing took ", t4-t3, " seconds"
  REPEAT outer
  IF maskimage#NULL THEN CLOSE(maskimage)
  CLOSE(diskimage)
  CLOSE(pressuredata)
REPEAT files

CLOSE(gkedata)
CLOSE(uiujimage)
