!
! Data structures shared by the two implementations of step 2
! (step2_gke.cpl and step2_gke_direct.cpl), which differ only in the way the
! raw pair sums of a pair of wall-parallel planes are computed.
!
! The raw pair sums at the separation (imx(jx),imz(jz)) of the pair of
! planes loaded as plane 1 and 2 are stored in SR(jj,k), jj=jx*mz+jz, with
! k named by the following constants. With du=u(x+r)-u(x) etc. denoting the
! velocity and pressure increments between the two planes,
! e2=du^2+dv^2+dw^2, vs=v(x)+v(x+r) and the sums extended over all pairs of
! fluid points (x,x+r):
!
!   kSE  = SUM e2            kFX  = SUM e2*du           kFY = SUM e2*dv
!   kFZ  = SUM e2*dw         kFC  = SUM 0.5*vs*e2+2*dp*dv
!   kUV  = SUM du*dv         kUVS = SUM du*vs
!   kGX  = SUM du_i*(d/dx u_i(x)+d/dx u_i(x+r))     (summed over i)
!   kGZ  = SUM du_i*(d/dz u_i(x)+d/dz u_i(x+r))     (summed over i)
!   kN   = number of pairs
!
kSE=1; kFX=2; kFY=3; kFZ=4; kFC=5; kUV=6; kUVS=7; kGX=8; kGZ=9; kN=10
ARRAY(0..mx*mz-1,1..10) OF REAL SR=0

! GKE terms of the IY2 planes paired with the current IY1
ARRAY(-1..ny+1,0..mx-1,0..mz-1) OF GKETERMS gke=0

! Renormalize the pair sums by the number of pairs and add the resulting
! contribution of the current pair of planes to gke(IY2,*,*); sig=-1 for the
! pairs of the upper half of the channel, mirrored onto the lower one
SUBROUTINE addpairsums(INTEGER IY2, sig)
  LOOP FOR jj=0 TO mx*mz-1 WITH gke(IY2,jj DIV mz,jj MOD mz)
    IF SR(jj,kN)>0.5 THEN
      REAL cn=1.0/SR(jj,kN)
      REAL iscaleENER=SR(jj,kSE)*cn
      scaleENER=~+iscaleENER
      phiR(1)=~+SR(jj,kFX)*cn+iscaleENER*[mean(2).U-mean(1).U]-2*ni*SR(jj,kGX)*cn
      phiR(2)=~+sig*SR(jj,kFY)*cn
      phiR(3)=~+SR(jj,kFZ)*cn+iscaleENER*[mean(2).W-mean(1).W]-2*ni*SR(jj,kGZ)*cn
      phiC=~+sig*[SR(jj,kFC)*cn]
      scalePROD=~-[SR(jj,kUV)*cn]*[mean(1).Uy+mean(2).Uy]-[SR(jj,kUVS)*cn]*[mean(2).Uy-mean(1).Uy]-[SUM uiuj(1).psdiss(i)+uiuj(2).psdiss(i) FOR i=1 TO 3]
    END IF
  REPEAT
END addpairsums

! The average over the snapshots is accumulated on disk: before processing
! IY1 for snapshot n, load the partial sums of the previous snapshots...
SUBROUTINE loadgke(INTEGER IY1, n)
  IF n>nfmin THEN gke(IY1+(0..ny-2*IY1),*,*)=gkedata(startpos(IY1)+(0..ny-2*IY1),*,*) ELSE gke(IY1+(0..ny-2*IY1),*,*)=0
END loadgke

! ...and store them back afterwards, normalized after the last snapshot
SUBROUTINE savegke(INTEGER IY1, n)
  IF n=nfmin+(nftot-1)*dn THEN WITH gke(IY1+(0..ny-2*IY1),*,*): INLINE LOOP FOR i IN (phiR,phiC,scaleENER,scalePROD) i=~*0.5/nftot; REPEAT
  gkedata(startpos(IY1)+(0..ny-2*IY1),*,*)=gke(IY1+(0..ny-2*IY1),*,*)
END savegke
