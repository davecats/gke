USE rbmat
USE namelist
USE dataset

! Parameters of the analysis, read from the namelist file "gke.in":
! snapshot range nfmin..nfmax by dn, and the separations sampled in x and z
! (every grid point up to uLx(1), every 4th up to uLx(2), every 8th beyond)
! -----------------------------
INLINE REAL FUNCTION setting(STRING name; INTEGER i)=nmlvalue("gke.in",name,i)
INTEGER nfmin=ROUND(setting("nfmin",1)), nfmax=ROUND(setting("nfmax",1)), dn=ROUND(setting("dn",1))
REAL uLx1=setting("uLx",1), uLx2=setting("uLx",2), uLz1=setting("uLz",1), uLz2=setting("uLz",2)
INTEGER nftot=[(nfmax-nfmin) DIV dn]+1
path="gke.bin"

! Parallel - initialization 
! -------------------------------------------
INTEGER iproc,nproc
IF COMMANDLINE.HI<1 THEN iproc=1; nproc=1 ELSE
iproc=atoi(COMMANDLINE(1)); nproc=atoi(COMMANDLINE(2)); END IF
first==(iproc=1); last==(iproc=nproc); has_terminal==last
IF has_terminal THEN
  WRITE BY NAME nproc
  WRITE BY NAME nx, ny, nz, Lx, Ly, Lz, 1/ni
  WRITE BY NAME nfmin, nfmax, dn, uLx1, uLx2, uLz1, uLz2
  ! With the default libgomp wait policy, busy-waiting threads can slow down
  ! the many small OpenMP parallel regions dramatically when all hardware
  ! threads are used; suggest the passive policy if none was chosen.
  <*
  #ifdef _OPENMP
  if(getenv("OMP_WAIT_POLICY")==NULL)fprintf(stderr,"HINT: consider setting OMP_WAIT_POLICY=passive, which can speed up the OpenMP parallel regions considerably.\n");
  #endif
  *>
END IF

! Finite differences: wall-normal operators on the grid y (5-point stencils,
! shifted near the walls), and second-order central differences in the
! periodic x and z directions (dudx, dvdy and dwdz are provided by dataset.cpl)
! -------------------------------------------
INLINE INTEGER FUNCTION yshift(INTEGER iy)=INTEGER((iy<1))*(-iy+1) - INTEGER((iy>(ny-1)))*(iy-ny+1)
STRUCTURE[ARRAY(-2..2) OF REAL d1,d2] derivs(-1..ny+1)
LOOP FOR iy=-1 TO ny+1 WITH derivs(iy):
  ARRAY(0..4,0..4) OF REAL matder=0
  ARRAY(0..4) OF REAL tnder=0
  DO matder(ir,ic) = (y(iy-2+ic+yshift(iy))-y(iy))^(4-ir) FOR ic=0 TO 4 AND ir=0 TO 4
  LUdecomp matder
  d1=0; tnder=0; tnder(3) = 1
  d1(-2+(*)) = matder\tnder
  d2=0; tnder=0; tnder(2) = 2
  d2(-2+(*)) = matder\tnder
REPEAT
nyl=-1+(iproc-1)*(ny DIV 2 +2) DIV nproc; nyh=iproc*(ny DIV 2 +2) DIV nproc -2

SUBROUTINE deriv2(ARRAY(*) OF REAL f0,f2^)
  DO WITH derivs(iy) f2(iy) = (SUM d2(i)*f0(iy+i+yshift(iy)) FOR i=-2 TO 2) FOR iy=-1 TO ny+1
END deriv2

SUBROUTINE deriv(ARRAY(*) OF REAL f0,f1^)
  DO WITH derivs(iy) f1(iy) = (SUM d1(i)*f0(iy+i+yshift(iy)) FOR i=-2 TO 2) FOR iy=-1 TO ny+1
END deriv

! Derivatives of a field f(iy,ix,iz) at one grid point
INLINE REAL FUNCTION ddx(REAL f(*,*,*); INTEGER iy,ix,iz)=[f(iy,(ix+1) MOD nx,iz)-f(iy,(ix+nx-1) MOD nx,iz)]/(2*dx)
INLINE REAL FUNCTION ddz(REAL f(*,*,*); INTEGER iy,ix,iz)=[f(iy,ix,(iz+1) MOD nz)-f(iy,ix,(iz+nz-1) MOD nz)]/(2*dz)
INLINE REAL FUNCTION ddy(REAL f(*,*,*); INTEGER iy,ix,iz)=(SUM derivs(iy).d1(i)*f(iy+i+yshift(iy),ix,iz) FOR i=-2 TO 2)

! Types
! -------------------------------------------
GKETERMS = STRUCTURE(ARRAY(1..3) OF REAL phiR; REAL phiC, scaleENER, scalePROD)
MEANTERMS = STRUCTURE(REAL U,W,Uy,Wy,Uyy,Wyy,P) 
MKETERMS = STRUCTURE(REAL pump,produv,prodvw,ttrsp,vdiff,dissU,dissW,PHIttrsp,PHIvdiff) 
BALANCE = STRUCTURE(ARRAY(1..6) OF REAL var,prod,psdiss,ttrsp,vdiff,pstrain,ptrsp,PHIttrsp,PHIvdiff,PHIptrsp) 

! Single-point statistics of the two planes of a pair
ARRAY(1..2) OF MEANTERMS mean
ARRAY(1..2) OF BALANCE uiuj

! Disk images
! -------------------------------------------
POINTER TO STORED STRUCTURE[
        ARRAY(-1..ny+1) OF MEANTERMS meandata
        ARRAY(-1..ny+1) OF MKETERMS mkedata
        ARRAY(-1..ny+1) OF BALANCE uiujdata
] uiujimage

! Undersampled separations: imx(0..mx-1), imz(0..mz-1)
! ------------------------------
! Returns the number of separations, stored in im, sampled up to half of a
! periodic direction with n points of spacing d and mirrored to the negative
! separations
INTEGER FUNCTION undersample(INTEGER n; REAL d, L1, L2; ARRAY(*) OF INTEGER im^)
  INTEGER i=0, m=0
  LOOP WHILE i<n DIV 2
    im(m)=i; INC m; i=~+[IF i*d<=L1 THEN 1 ELSE [IF i*d<=L2 THEN 4 ELSE 8]]
  REPEAT
  im(m)=n DIV 2; INC m
  DO im(m+k-1)=n-im(m-k-1) FOR k=1 TO m-2
  RESULT=2*m-2
END undersample
ARRAY(0..nx) OF INTEGER imx=0; INTEGER mx=undersample(nx,dx,uLx1,uLx2,imx)
ARRAY(0..nz) OF INTEGER imz=0; INTEGER mz=undersample(nz,dz,uLz1,uLz2,imz)
WRITE BY NAME mx,mz

! Output
! -----------------------------
INTEGER startpos(-1..ny DIV 2 +1)=0
DO startpos(iy+1)=startpos(iy)+(ny-2*iy+1) FOR iy=-1 TO ny DIV 2
POINTER TO STORED ARRAY(0..startpos(ny DIV 2 +1)-1,0..mx-1,0..mz-1) OF GKETERMS gkedata

! Load MEANTERMS and BALANCE
! ------------------------------
uiujimage=OPENRO("uiuj.bin")

! Open data for output
! ------------------------------
gkedata=OPEN(path)
IF has_terminal THEN WRITE "Will require " SIZEOF(ARRAY(0..startpos(ny DIV 2 +1)-1,0..mx-1,0..mz-1) OF GKETERMS)/(1024.0**3) " GiB on disk..."

! Fields of a pair of wall-parallel planes
! -----------------------------------------------------------------
! PH(i,f,ix,iz) holds field f of plane i, with the field index f named by
! the following constants (velocity and pressure fluctuations, x- and
! z-derivatives of the velocity); gmask(i,ix,iz) is the fluid indicator.
! One plane of one field is contiguous, which the GPU kernel of
! step2_gke_direct.cpl relies upon for coalesced access.
fU=1; fV=2; fW=3; fP=4; fUX=5; fVX=6; fWX=7; fUZ=8; fVZ=9; fWZ=10
ARRAY(1..2,1..10,0..nx-1,0..nz-1) OF REAL PH=0
ARRAY(1..2,0..nx-1,0..nz-1) OF REAL gmask=0

! Load plane iy of the current snapshot as plane i, together with its
! single-point statistics
SUBROUTINE loadplane(INTEGER i, iy)
  mean(i)=uiujimage.meandata(iy); uiuj(i)=uiujimage.uiujdata(iy)
#pragma omp parallel for
  LOOP FOR ix=0 TO nx-1
    DO WITH mean(i)
      PH(i,fU,ix,iz)=u(iy,ix,iz)-U; PH(i,fV,ix,iz)=v(iy,ix,iz); PH(i,fW,ix,iz)=w(iy,ix,iz)-W; PH(i,fP,ix,iz)=p(iy,ix,iz)-P
      PH(i,fUX,ix,iz)=dudx(iy,ix,iz); PH(i,fVX,ix,iz)=ddx(v,iy,ix,iz); PH(i,fWX,ix,iz)=ddx(w,iy,ix,iz)
      PH(i,fUZ,ix,iz)=ddz(u,iy,ix,iz); PH(i,fVZ,ix,iz)=ddz(v,iy,ix,iz); PH(i,fWZ,ix,iz)=dwdz(iy,ix,iz)
      gmask(i,ix,iz)=fluid(iy,ix,iz)
    FOR iz=0 TO nz-1
  REPEAT LOOP
END loadplane
